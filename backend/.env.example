# Copia este archivo como .env y completa los valores. Nunca subas .env al repositorio.

PORT=3000

# "simulado" usa las respuestas de fixtures/ y no gasta créditos.
# "real" consulta PlacApi y requiere PLACAPI_KEY.
PLACAPI_MODO=simulado
# PLACAPI_KEY=
PLACAPI_TIMEOUT_MS=90000

# Orígenes del frontend que pueden llamar la API.
CORS_ORIGENES=http://localhost:5173,http://localhost:3000

# Secreto para los hash del documento y la IP. Obligatorio en producción.
# Genera uno con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# DOC_HASH_SECRETO=

# Cloudflare Turnstile (anti-bots). Obligatorio en producción.
# TURNSTILE_SECRETO=

# Supabase. Sin estas dos, los datos quedan en memoria y disco (solo desarrollo).
# La llave secreta (service role) nunca debe llegar al frontend.
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_LLAVE_SECRETA=

# Wompi: Dashboard > Desarrolladores. Obligatorias en producción.
# WOMPI_LLAVE_PUBLICA=pub_test_...
# WOMPI_SECRETO_INTEGRIDAD=
# WOMPI_SECRETO_EVENTOS=
# WOMPI_URL_REDIRECCION=https://sudominio.com/compra-resultado.html
# Llave privada (prv_): confirma pagos consultando a Wompi si el webhook no llega. Obligatoria en producción.
# WOMPI_LLAVE_PRIVADA=

# Resend: correos de "compra aprobada" e "informe listo". Sin llave solo se registran en el log.
# RESEND_LLAVE=
# CORREO_REMITENTE=Carro Sin Rollos <no-responder@sudominio.com>
# URL pública del sitio, para los enlaces de los correos.
SITIO_URL=http://localhost:5173

# Consultas fallidas por datos (cédula que no coincide, sin resultados) por usuario en 24 h. 0 = sin límite.
LIMITE_FALLIDAS_DIA=5
# Créditos de PlacApi por día a partir de los cuales se registra una alerta. 0 = sin alerta.
ALERTA_CREDITOS_DIA=0

# Días que el PDF se puede ver y descargar.
PDF_DIAS_VIGENCIA=7

# Chrome del sistema para desarrollo (ej. /usr/bin/google-chrome-stable).
# Vacío = el Chromium de Playwright (npx playwright install chromium) o el de la imagen Docker.
# CHROME_PATH=

ALMACENAMIENTO_DIR=data/pdfs
