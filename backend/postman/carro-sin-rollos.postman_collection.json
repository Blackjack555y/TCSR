    {
      "name": "Compras",
      "item": [
        {
          "name": "Crear compra",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "      pm.test('201', () => pm.response.to.have.status(201));",
                  "      const r = pm.response.json();",
                  "      pm.environment.set('compra_id', r.compra.id);",
                  "      pm.environment.set('compra_referencia', r.widget.reference);",
                  "      pm.environment.set('compra_centavos', r.widget.amountInCents);",
                  "      pm.test('firma de integridad', () => pm.expect(r.widget.signatureIntegrity).to.have.length(64));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/api/compras",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "compras"
              ]
            },
            "description": "Crea la compra pendiente y devuelve los datos para abrir el widget de Wompi. El precio lo calcula el servidor.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tipo\": \"full\",\n  \"cantidad\": 2\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Webhook de Wompi (pago aprobado)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "        const tx = 'TX-' + Date.now();",
                  "        const ts = Math.floor(Date.now() / 1000);",
                  "        const monto = pm.environment.get('compra_centavos');",
                  "        pm.variables.set('tx_id', tx);",
                  "        pm.variables.set('tx_timestamp', ts);",
                  "        pm.variables.set('tx_checksum', CryptoJS.SHA256(tx + 'APPROVED' + monto + ts + pm.environment.get('wompi_secreto_eventos')).toString());",
                  "        // El monto debe ir como número en el cuerpo.",
                  "        pm.request.body.raw = pm.request.body.raw.replace('\"{{compra_centavos}}\"', monto).replace('\"{{tx_timestamp}}\"', ts);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "        pm.test('Wompi recibe 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/api/webhooks/wompi",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "webhooks",
                "wompi"
              ]
            },
            "description": "Simula el evento transaction.updated de Wompi, firmado con `wompi_secreto_eventos`. Enviarlo dos veces acredita una sola vez.",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event\": \"transaction.updated\",\n  \"data\": {\n    \"transaction\": {\n      \"id\": \"{{tx_id}}\",\n      \"status\": \"APPROVED\",\n      \"reference\": \"{{compra_referencia}}\",\n      \"amount_in_cents\": \"{{compra_centavos}}\",\n      \"payment_method_type\": \"PSE\"\n    }\n  },\n  \"timestamp\": \"{{tx_timestamp}}\",\n  \"signature\": {\n    \"properties\": [\n      \"transaction.id\",\n      \"transaction.status\",\n      \"transaction.amount_in_cents\"\n    ],\n    \"checksum\": \"{{tx_checksum}}\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
